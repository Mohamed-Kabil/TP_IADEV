# Copier ce fichier en .env (ignoré par Git) et remplir les valeurs.
# Générer deux clés locales avec python scripts/configurer_tp2.py.
# Une clé réelle possède au moins 16 caractères ; ne jamais la commiter.
API_KEYS=REMPLACER_CLE_CLIENT:client,REMPLACER_CLE_ADMIN:admin
API_KEY=REMPLACER_CLE_CLIENT
API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
